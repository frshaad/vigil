{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --fix --type-aware",
    "fmt": "oxfmt",
    "fix": "pnpm fmt && pnpm lint:types",
    "typegen": "next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "check:ci": "pnpm check && pnpm build",
    "email:dev": "email dev --dir ./src/features/email/templates",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/prisma-adapter": "^1.7.2",
    "@hookform/resolvers": "^5.9.1",
    "@next-safe-action/adapter-better-auth": "^0.1.7",
    "@next-safe-action/adapter-react-hook-form": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "next": "^16.3.4",
    "next-safe-action": "^8.6.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "6.9.3",
    "react-hook-form": "^7.86.0",
    "resend": "^6.22.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-complexity": "^2.1.8",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint --type-aware",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
