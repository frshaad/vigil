generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
}

enum MonitorMethod {
  GET
  PATCH
  POST
  DELETE
  PUT
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum NotificationChannelType {
  EMAIL
  TELEGRAM
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model User {
  id                   String                @id
  name                 String
  email                String
  emailVerified        Boolean
  image                String?
  createdAt            DateTime
  updatedAt            DateTime
  sessions             Session[]
  accounts             Account[]
  monitors             Monitor[]
  notificationChannels NotificationChannel[]
  subscription         Subscription?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Monitor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  url    String
  method MonitorMethod @default(GET)

  intervalSeconds    Int           @default(60)
  isActive           Boolean       @default(true)
  lastCheckedAt      DateTime?
  lastStatus         MonitorStatus @default(UNKNOWN)
  lastStatusCode     Int?
  lastResponseTimeMs Int?

  incidents            Incident[]
  notificationChannels NotificationChannel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("monitor")
}

model Incident {
  id        String   @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  startedAt  DateTime
  resolvedAt DateTime?
  status     IncidentStatus @default(OPEN)

  statusCode Int?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monitorId, startedAt])
  @@map("incident")
}

model NotificationChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationChannelType
  name      String
  config    Json
  isEnabled Boolean                 @default(true)

  monitors Monitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification_channel")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   Plan               @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}
