{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --fix --type-aware",
    "fmt": "oxfmt",
    "fix": "pnpm fmt && pnpm lint:fix",
    "typegen": "next typegen",
