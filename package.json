    "oxlint": "^1.76.0",
    "oxlint-plugin-complexity": "^2.1.6",
    "oxlint-tsgolint": "^7.0.2001",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint --type-aware",
